# Modèle de configuration du frontend. Copiez ce fichier en `.env`.
#
# Ce fichier-ci est versionné : n'y écrivez jamais de secret.
#
# Tout ce qui commence par VITE_ est inclus dans le bundle et donc lisible par
# n'importe quel visiteur. La clé service_role n'a rien à faire ici : elle va
# dans server/.env, et nulle part ailleurs.

# Supabase — Project Settings → API
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Email du super admin racine. Sert uniquement à afficher ou masquer les liens
# d'administration avant que le profil ne soit chargé ; l'autorisation réelle
# est toujours vérifiée en base et côté API. Doit correspondre au réglage
# `root_super_admin_email` renseigné par `npm run create:super-admin`.
VITE_SUPER_ADMIN_EMAIL=vous@exemple.com

# L'API backend n'a pas besoin d'URL : le client appelle `/api`, que Vite
# redirige vers http://localhost:3001 en développement (voir vite.config.js).
# En production, servez le frontend et l'API derrière le même domaine, ou
# ajoutez une règle de proxy équivalente.
