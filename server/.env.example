# Verify AI — modèle de configuration du backend.
#
# Copiez ce fichier en `server/.env` puis remplacez les valeurs. Ce fichier-ci
# est versionné : n'y écrivez JAMAIS une vraie clé, elle partirait dans
# l'historique git dès le prochain commit.

# Groq API (Obligatoire)
# Obtenez votre clé ici : https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Modèle Groq à utiliser par défaut (FREE TIER compatible — Sept 2026)
# Llama models are enterprise-only since 2026-08-16
GROQ_MODEL=openai/gpt-oss-120b

# SerpAPI (Obligatoire pour les recherches web réelles)
# Obtenez votre clé ici : https://serpapi.com/manage-api-key
SERPAPI_KEY=your_serpapi_key_here

# Supabase — Project Settings → API
#
# La clé service_role ignore la sécurité au niveau des lignes : elle ne doit
# jamais être copiée dans un fichier VITE_*, ni committée. Sans elle, la
# console super admin reste utilisable mais ne peut pas agir sur auth.users
# (création de compte, suppression, réinitialisation de mot de passe,
# révocation de session).
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Empreinte des visiteurs non connectés. Si elle est absente, le serveur en
# dérive une de la clé service_role. Définissez-la seulement si vous voulez
# que le hash reste stable même après un changement de clé Supabase.
# VISITOR_HASH_SECRET=une_chaine_longue_et_aleatoire

# Configuration du serveur
PORT=3001
CLIENT_URL=http://localhost:5173

# Configuration CORS (optionnel)
# CORS_ORIGIN=*

# Configuration Rate Limiting (optionnel)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=50
